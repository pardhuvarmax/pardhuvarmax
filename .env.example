# Generate a cryptographically random Base32 secret for production.
# Never use a public/example secret.
TOTP_SECRET=REPLACE_WITH_YOUR_RANDOM_BASE32_SECRET
TOTP_QR_PASSWORD=SET_A_STRONG_PASSWORD_FOR_QR_REGEN
TOTP_ISSUER=PardhuPortfolio
TOTP_ACCOUNT=pardhu-researcher

VITE_TOTP_SETUP_URL=/api/totp/setup
VITE_TOTP_STATUS_URL=/api/totp/status
VITE_TOTP_VERIFY_URL=/api/totp/verify

# --- Content admin (/admin) ---
# Login uses the TOTP_SECRET above (scan the QR from /api/totp/setup, or add the secret to your authenticator).
# Optional: separate secret for signing the admin session cookie.
ADMIN_SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
# Production saves are committed to GitHub through the Contents API.
# Token needs "Contents: Read and write" on the repository below (fine-grained PAT).
GITHUB_TOKEN=REPLACE_WITH_FINE_GRAINED_TOKEN
GITHUB_REPO=pardhuvarmax/pardhuvarmax
GITHUB_BRANCH=main

# --- Sign in with Google (optional, alongside the authenticator code) ---
# 1. Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID -> "Web application".
# 2. Add your site (https://your-domain and http://localhost:5173 for dev) under "Authorized JavaScript origins".
# 3. Paste the client ID here. Only the accounts listed in ADMIN_EMAILS can sign in.
# ADMIN_SESSION_SECRET (above) is REQUIRED for Google sign-in.
GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_CLIENT_ID.apps.googleusercontent.com
ADMIN_EMAILS=pardhuvarma.cs@gmail.com

# --- Sign in with GitHub / ORCID (optional) ---
# GitHub: Settings -> Developer settings -> OAuth Apps -> New. Authorization callback URL: https://YOUR-DOMAIN/auth/github/callback
# ORCID:  orcid.org -> Developer tools -> Register for the free public API. Redirect URI: https://YOUR-DOMAIN/auth/orcid/callback
# Only these accounts can sign in. Needs ADMIN_SESSION_SECRET too. SITE_URL is optional (https://YOUR-DOMAIN) if the callback origin is detected wrongly.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ADMIN_GITHUB_USERS=pardhuvarmax
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ADMIN_ORCIDS=0009-0005-3251-9944
